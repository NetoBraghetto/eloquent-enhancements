{
    "name": "sigep/eloquent-enhancements",
    "type": "library",
    "description": "This package aims to provide extra functionalities to Laravel's Eloquent",
    "keywords": ["eloquent","laravel"],
    "license": "MIT",
    "authors": [
        {
            "name": "Luís Henrique",
            "email": "luish.faria@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1.0",
        "illuminate/database": "~10.12",
        "illuminate/support": "~10.12"
    },
    "require-dev": {
        "orchestra/testbench": "~8",
        "phpunit/phpunit": "~10.1"
    },
    "autoload": {
        "psr-4": {
            "Sigep\\EloquentEnhancements\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Database\\": "./tests/database"
        },
        "classmap": [
            "tests/"
        ]
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "./vendor/bin/phpunit"
    }
}
